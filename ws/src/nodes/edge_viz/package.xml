<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edge_viz</name>
  <version>0.3.0</version>
  <description>Browser visualizer for haul-edge sensors (StreamHub or ROS bus).</description>
  <maintainer email="nilushan.silva@gmail.com">Nilushan Silva</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>edge_sim</depend>
  <depend>edge_perception</depend>
  <!-- bus mode only -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>edge_sensor_source</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
